  "weaknesses": {
    "operator_drops_tail_and_rewinds_head": {
      "case": "ledger_tampering",
      "attempts": 20,
      "accepted": 20,
      "explanation": "Someone who can write both ledger.jsonl and state.json can drop recent entries and move the recorded head back; verification passes. Documented: the ledger is tamper-evident, not tamper-proof."
    },
    "operator_rewrites_chain_and_head": {
      "case": "ledger_tampering",
      "attempts": 20,
      "accepted": 20,
      "explanation": "Someone who can write both files can edit an entry, recompute every later hash and update the recorded head; verification passes. Documented limitation; external anchoring is an open question."
    },
    "proof_replay_verify_twice": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 20,
      "explanation": "verify_proof() is a lookup, not a one-time check: the same genuine proof verifies every time. Single use must be enforced by the host (for example by recording executed action_ids)."
    },
    "proof_valid_after_lease_revoked": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 20,
      "explanation": "A proof still verifies after its lease is revoked. verify_proof() answers 'was this authorised?', not 'is this still authorised now?'; freshness is left to the host."
    },
    "lease_token_replay": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 20,
      "explanation": "An HMAC lease token binds avatar, version, capability and approver, but no nonce, so a captured token grants further leases for the same capability and version."
    },
    "lease_token_budget_unbound": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 20,
      "explanation": "The lease token does not bind max_actions or the TTL, so a token issued for a 1-action lease also grants a lease at the capability's full cap."
    },
    "clear_halt_token_replay": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 20,
      "explanation": "The clear_halt token binds only the avatar's identity root, so an old token clears any later halt of that avatar."
    },
    "proof_valid_after_version_superseded": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 20,
      "explanation": "A proof issued under one personality version still verifies after a new version is committed and that version is no longer active."
    },
    "module_token_replay_recommits_old_version": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 20,
      "explanation": "Module tokens bind the manifest checksum, not an upload event, so re-uploading a superseded manifest and replaying its old tokens re-commits it without fresh human approval."
    }
  },
