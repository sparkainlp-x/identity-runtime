  "weaknesses": {
    "operator_drops_tail_and_rewinds_head": {
      "case": "ledger_tampering",
      "attempts": 20,
      "accepted": 20,
      "explanation": "Someone who can write both ledger.jsonl and state.json can drop recent entries and move the recorded head back; verification passes. Documented: the ledger is tamper-evident, not tamper-proof."
    },
    "operator_rewrites_chain_and_head": {
      "case": "ledger_tampering",
      "attempts": 20,
      "accepted": 20,
      "explanation": "Someone who can write both files can edit an entry, recompute every later hash and update the recorded head; verification passes. Documented limitation; external anchoring is an open question."
    }
  },
  "former_weaknesses": {
    "proof_redeemed_twice": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 0,
      "fix": "Proofs are single use: redeem_proof() records the action as redeemed (persisted in state.json) and refuses a second redemption."
    },
    "proof_check_after_redeem": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 0,
      "fix": "verify_proof()/check_proof() are current-only: a redeemed proof no longer verifies. proof_in_ledger() is the audit-only historical lookup."
    },
    "lease_token_replay": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 0,
      "fix": "Signed lease grants need a nonce, which the runtime records; a replayed token and nonce are refused."
    },
    "lease_token_budget_changed": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 0,
      "fix": "The lease token binds the full effective terms (version, capability, contexts, human-review flag, max_actions, TTL); a different budget does not verify."
    },
    "lease_token_ttl_changed": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 0,
      "fix": "A different TTL does not verify either."
    },
    "proof_redeem_after_lease_revoked": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 0,
      "fix": "A proof is refused once its lease is revoked."
    },
    "clear_halt_token_replay": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 0,
      "fix": "A clear_halt token binds the specific halt id, so it cannot clear a later halt."
    },
    "proof_redeem_after_version_superseded": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 0,
      "fix": "A proof is refused once its personality version is no longer active."
    },
    "module_token_replay_recommits_old_version": {
      "case": "proof_forgery_and_replay",
      "attempts": 20,
      "accepted": 0,
      "fix": "Module tokens bind the upload's proposal id; re-uploading a superseded manifest creates a new proposal that needs fresh approvals."
    }
  },
